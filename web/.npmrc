# pnpm's self-version-switching downloads @pnpm/exe, which has no musl build, so it
# breaks on Alpine-based CI images (nebula-go pins pnpm 10.33.4 vs. the packageManager
# field's 10.33.0). The field stays for corepack and pnpm/action-setup; this just stops
# pnpm from trying to replace itself at runtime.
manage-package-manager-versions=false
